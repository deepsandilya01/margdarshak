# BIS-SATHI Primary Server Environment Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (supports both local and MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/bis-sathi

# JWT Authentication Secrets
JWT_ACCESS_SECRET=dev_access_secret_change_in_production_12345
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email / SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
SMTP_FROM=noreply@bis-sathi.gov.in

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Internal Node.js AI providers (never expose these values to the frontend)
MISTRAL_API_KEY=Z9hcUry1jlN47T8FhUMW9kHhGh5llsnA
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed
AI_TIMEOUT_MS=30000

# Pinecone vector store
PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_NAMESPACE=bis-documents

# Tavily web fallback (used only when RAG evidence is insufficient)
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5

# RAG evidence thresholds
RAG_TOP_K=8
RAG_MIN_SCORE=0.72
RAG_MIN_EVIDENCE=2
RAG_CONFIDENCE_THRESHOLD=0.78
RAG_MIN_COVERAGE=0.25
BIS_PDF_DIR=./data/bis-pdfs
BIS_INGESTION_MANIFEST=./data/bis-ingestion-manifest.json

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
FRONTEND_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback

# Redis Configuration
REDIS_URL=redis://:<REDIS_PASSWORD>@redis-14740.c83.us-east-1-2.ec2.cloud.redislabs.com:14740
